<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b"/>
      <stop offset="100%" style="stop-color:#0f172a"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b"/>
      <stop offset="100%" style="stop-color:#334155"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#2563EB"/>
      <stop offset="100%" style="stop-color:#10B981"/>
    </linearGradient>
    <filter id="shadow"><feDropShadow dx="0" dy="2" stdDeviation="4" flood-opacity="0.3"/></filter>
  </defs>
  <rect width="800" height="500" fill="url(#bgGrad)" rx="8"/>
  <rect x="0" y="0" width="800" height="40" fill="#0f172a" rx="8"/>
  <rect x="0" y="32" width="800" height="8" fill="#0f172a"/>
  <circle cx="20" cy="20" r="6" fill="#ef4444"/>
  <circle cx="40" cy="20" r="6" fill="#f59e0b"/>
  <circle cx="60" cy="20" r="6" fill="#10B981"/>
  <text x="400" y="25" text-anchor="middle" fill="#94a3b8" font-family="monospace" font-size="12">churn_prediction_dashboard.ipynb</text>
  <rect x="20" y="55" width="370" height="200" fill="url(#cardGrad)" rx="6" filter="url(#shadow)"/>
  <text x="35" y="78" fill="#e2e8f0" font-family="Inter,sans-serif" font-size="13" font-weight="600">Churn Rate by Segment</text>
  <line x1="50" y1="100" x2="50" y2="230" stroke="#475569" stroke-width="1"/>
  <line x1="50" y1="230" x2="370" y2="230" stroke="#475569" stroke-width="1"/>
