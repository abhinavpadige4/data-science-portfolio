  <text x="330" y="248" fill="#94a3b8" font-size="9" text-anchor="middle">Family</text>
  <rect x="410" y="55" width="370" height="200" fill="url(#cardGrad)" rx="6" filter="url(#shadow)"/>
  <text x="425" y="78" fill="#e2e8f0" font-family="Inter,sans-serif" font-size="13" font-weight="600">Model Performance Metrics</text>
  <rect x="430" y="95" width="150" height="50" fill="#1e293b" rx="4"/>
  <text x="505" y="115" text-anchor="middle" fill="#64748b" font-size="10">Accuracy</text>
  <text x="505" y="135" text-anchor="middle" fill="#10B981" font-size="18" font-weight="700">94.2%</text>
  <rect x="595" y="95" width="150" height="50" fill="#1e293b" rx="4"/>
