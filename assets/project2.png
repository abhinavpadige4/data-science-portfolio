  <text x="150" y="446" fill="#94a3b8" font-size="10">Payment Method</text>
  <text x="730" y="446" fill="#e2e8f0" font-size="10" text-anchor="end">0.074</text>
  <rect x="50" y="460" width="65" height="14" fill="#8b5cf6" rx="2"/>
  <text x="125" y="471" fill="#94a3b8" font-size="10">Internet Speed</text>
  <text x="730" y="471" fill="#e2e8f0" font-size="10" text-anchor="end">0.054</text>
  <rect x="20" y="485" width="760" height="1" fill="#334155"/>
  <text x="35" y="497" fill="#475569" font-size="9">Project 2: Customer Churn Prediction — Random Forest Classifier with 94.2% accuracy on telecom dataset</text>
